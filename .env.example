# placeforge settings for this project. Copy to .env (pf init does it) and fill in. Never commit .env.

# Where renders run:
#   local  this machine: its GPU if Blender supports it (Apple Metal, NVIDIA OptiX/CUDA, AMD HIP, Intel oneAPI), else the CPU
#   vast   rent a GPU on https://vast.ai by the hour (fastest for films; needs VAST_API_KEY)
#   ssh    a machine you already have: RunPod, Lambda, a workstation (needs PF_SSH_HOST)
PF_COMPUTE=local

# --- vast: key from https://cloud.vast.ai/account/ (add a few dollars of credit first)
VAST_API_KEY=
# never rent above this price per hour (an RTX 4090 is usually 0.30 to 0.50)
VAST_MAX_PRICE=0.60
# ssh key used for rented machines (created and registered on your Vast account if missing)
VAST_SSH_KEY=~/.ssh/placeforge_ed25519
# skip hosts in these countries when they boot or transfer slowly for you, e.g. BR,CN,AR,IN,VN,ID,ZA,TR
VAST_NOT_GEO=

# --- ssh: any Linux machine with an NVIDIA GPU you can log in to
PF_SSH_HOST=
PF_SSH_PORT=22
PF_SSH_USER=root
PF_SSH_KEY=~/.ssh/id_ed25519

# Blender version to install on the remote machine (default: the version on this machine)
BLENDER_VER=
# Blender binary here, if it is not on the PATH
PF_BLENDER=
